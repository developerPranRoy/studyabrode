// AbroadMates data model (PostgreSQL).
//
// Reference data (regions, countries, programs, study fields, budget ranges, funding needs, help
// topics, acquisition sources, services, session categories, scholarships) lives in tables and is
// never hard-coded in the API. Only small state enums that application logic branches on are enums.
// Reads go through the SQL functions in prisma/sql/functions.sql; writes use Prisma.
// Tables are snake_case via @@map; columns stay camelCase (quoted in SQL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  MENTOR
}

enum BookingStatus {
  PENDING // created, waiting for payment
  CONFIRMED
  CANCELLED // withdrawn by the student
}

enum TokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum StayPlan {
  YES
  NO
  NOT_ESSENTIAL
}

enum ApplyMode {
  SELF
  ASSISTED
}

enum NotificationType {
  BOOKING
  SESSION
  ACCOUNT
}

// ------------------------------------------------------------------ users ----

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  passwordHash    String? // null for Google-only accounts
  googleId        String?   @unique
  firstName       String
  lastName        String
  role            Role
  timezone        String    @default("UTC") // IANA name, e.g. Asia/Dhaka
  emailVerifiedAt DateTime?
  referralCode    String    @unique
  referredById    Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  referredBy User?  @relation("Referrals", fields: [referredById], references: [id])
  referrals  User[] @relation("Referrals")

  studentProfile       StudentProfile?
  mentorProfile        MentorProfile?
  bookings             Booking[]
  hostedSessions       GroupSession[]
  sessionRegistrations SessionRegistration[]
  savedMentors         SavedMentor[]
  notifications        Notification[]
  authTokens           AuthToken[]

  @@index([referredById])
  @@map("users")
}

// One-time email links (verification, password reset). Only the SHA-256 hash is stored.
model AuthToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// ------------------------------------------------------- onboarding options ----

model Region {
  id         Int     @id @default(autoincrement())
  name       String  @unique
  slug       String  @unique
  isFlexible Boolean @default(false) // the "I'm flexible!" choice: matches every region
  sortOrder  Int     @default(0)

  countries       Country[]
  studentRegions  StudentRegion[]

  @@map("regions")
}

model StudyField {
  id        Int    @id @default(autoincrement())
  name      String @unique
  slug      String @unique
  sortOrder Int    @default(0)

  studentFields StudentField[]

  @@map("study_fields")
}

model BudgetRange {
  id        Int    @id @default(autoincrement())
  name      String @unique // "Under $10,000 / year"
  minUsd    Int
  maxUsd    Int? // null = open ended
  sortOrder Int    @default(0)

  studentProfiles StudentProfile[]

  @@map("budget_ranges")
}

model FundingNeed {
  id        Int    @id @default(autoincrement())
  name      String @unique
  slug      String @unique
  sortOrder Int    @default(0)

  studentProfiles StudentProfile[]

  @@map("funding_needs")
}

model HelpTopic {
  id        Int    @id @default(autoincrement())
  name      String @unique
  slug      String @unique
  sortOrder Int    @default(0)

  studentHelpTopics StudentHelpTopic[]

  @@map("help_topics")
}

model AcquisitionSource {
  id        Int    @id @default(autoincrement())
  name      String @unique
  slug      String @unique
  sortOrder Int    @default(0)

  studentProfiles StudentProfile[]

  @@map("acquisition_sources")
}

// Also used as the mentor "Program" filter.
model Program {
  id        Int    @id @default(autoincrement())
  name      String @unique
  slug      String @unique
  sortOrder Int    @default(0)

  mentorProfiles  MentorProfile[]
  studentProfiles StudentProfile[]

  @@map("programs")
}

// ---------------------------------------------------------- student profile ----

model StudentProfile {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  programId         Int
  budgetRangeId     Int
  fundingNeedId     Int
  sourceId          Int
  workWhileStudying Boolean
  stayAfterStudy    StayPlan
  ieltsTaken        Boolean
  ieltsScore        Decimal? @db.Decimal(2, 1)
  applyMode         ApplyMode
  countriesOther    Boolean  @default(false) // picked "Other" in the countries step
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  program     Program           @relation(fields: [programId], references: [id])
  budgetRange BudgetRange       @relation(fields: [budgetRangeId], references: [id])
  fundingNeed FundingNeed       @relation(fields: [fundingNeedId], references: [id])
  source      AcquisitionSource @relation(fields: [sourceId], references: [id])

  fields      StudentField[]
  regions     StudentRegion[]
  countries   StudentCountry[]
  helpTopics  StudentHelpTopic[]

  @@map("student_profiles")
}

model StudentField {
  studentId Int
  fieldId   Int

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  field   StudyField     @relation(fields: [fieldId], references: [id])

  @@id([studentId, fieldId])
  @@map("student_fields")
}

model StudentRegion {
  studentId Int
  regionId  Int

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  region  Region         @relation(fields: [regionId], references: [id])

  @@id([studentId, regionId])
  @@map("student_regions")
}

model StudentCountry {
  studentId Int
  countryId Int

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  country Country        @relation(fields: [countryId], references: [id])

  @@id([studentId, countryId])
  @@map("student_countries")
}

model StudentHelpTopic {
  studentId   Int
  helpTopicId Int

  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  helpTopic HelpTopic      @relation(fields: [helpTopicId], references: [id])

  @@id([studentId, helpTopicId])
  @@map("student_help_topics")
}

model SavedMentor {
  studentId Int
  mentorId  Int
  createdAt DateTime @default(now())

  student User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mentor  MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@id([studentId, mentorId])
  @@index([mentorId])
  @@map("saved_mentors")
}

// -------------------------------------------------------- mentor reference ----

model Country {
  id          Int    @id @default(autoincrement())
  name        String @unique // must match the external university API's spelling
  slug        String @unique
  title       String // SEO title of the country page
  description String // intro text of the country page
  regionId    Int

  region           Region           @relation(fields: [regionId], references: [id])
  universities     University[]
  mentorProfiles   MentorProfile[]
  studentCountries StudentCountry[]

  @@index([regionId])
  @@map("countries")
}

// Filled on demand from the external university API when a mentor saves a profile.
model University {
  id        Int    @id @default(autoincrement())
  name      String
  countryId Int

  country        Country         @relation(fields: [countryId], references: [id])
  mentorProfiles MentorProfile[]

  @@unique([name, countryId])
  @@index([countryId])
  @@map("universities")
}

model Scholarship {
  id          Int    @id @default(autoincrement())
  name        String @unique
  slug        String @unique
  region      String
  title       String
  description String

  mentorProfiles MentorProfile[]

  @@map("scholarships")
}

// Bookable call type, e.g. "20 min call" / "40 min call".
model Service {
  id          Int    @id @default(autoincrement())
  name        String @unique
  slug        String @unique
  durationMin Int    @unique

  plans MentorPlan[]

  @@map("services")
}

model SessionCategory {
  id   Int    @id @default(autoincrement())
  name String @unique
  slug String @unique

  sessions GroupSession[]

  @@map("session_categories")
}

// ------------------------------------------------------------------ mentors ----

// MASTER
model MentorProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  headline      String
  bio           String
  rating        Decimal  @default(0) @db.Decimal(2, 1)
  photoPath     String?
  cvPath        String?
  countryId     Int
  universityId  Int
  programId     Int
  scholarshipId Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  country     Country      @relation(fields: [countryId], references: [id])
  university  University   @relation(fields: [universityId], references: [id])
  program     Program      @relation(fields: [programId], references: [id])
  scholarship Scholarship? @relation(fields: [scholarshipId], references: [id])
  plans       MentorPlan[]
  bookings    Booking[]
  savedBy     SavedMentor[]

  @@index([countryId])
  @@index([universityId])
  @@index([programId])
  @@index([scholarshipId])
  @@map("mentor_profiles")
}

// DETAIL: one row per service a mentor offers, with that mentor's price
model MentorPlan {
  id        Int     @id @default(autoincrement())
  mentorId  Int
  serviceId Int
  price     Decimal @db.Decimal(10, 2) // USD

  mentor   MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  service  Service       @relation(fields: [serviceId], references: [id])
  bookings Booking[]

  @@unique([mentorId, serviceId])
  @@index([serviceId])
  @@map("mentor_plans")
}

model Booking {
  id             Int           @id @default(autoincrement())
  studentId      Int
  mentorId       Int // denormalised from plan to make slot checks and mentor queries cheap
  planId         Int
  scheduledAt    DateTime
  priceAtBooking Decimal       @db.Decimal(10, 2) // price snapshot, plans may change later
  status         BookingStatus @default(PENDING)
  createdAt      DateTime      @default(now())

  student User          @relation(fields: [studentId], references: [id])
  mentor  MentorProfile @relation(fields: [mentorId], references: [id])
  plan    MentorPlan    @relation(fields: [planId], references: [id])

  @@index([studentId])
  @@index([mentorId, scheduledAt])
  @@map("bookings")
}

model GroupSession {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  categoryId  Int
  startsAt    DateTime
  endsAt      DateTime
  location    String   @default("Online")
  createdById Int
  createdAt   DateTime @default(now())

  category      SessionCategory       @relation(fields: [categoryId], references: [id])
  createdBy     User                  @relation(fields: [createdById], references: [id])
  registrations SessionRegistration[]

  @@index([startsAt])
  @@index([categoryId])
  @@map("group_sessions")
}

model SessionRegistration {
  id        Int      @id @default(autoincrement())
  sessionId Int
  studentId Int
  createdAt DateTime @default(now())

  session GroupSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("session_registrations")
}
