NODE_ENV=development
PORT=5000

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/abroadmates?schema=public"

# JWT: use a long random value (>= 32 chars), e.g. `openssl rand -hex 32`
JWT_SECRET=replace-me-with-a-long-random-secret-of-32-chars-or-more
JWT_EXPIRES_IN=1d

# Browser origin(s) of the Next.js client (comma separated) and its public base URL (used in email links)
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000

# Uploaded photos / CVs (relative to the working dir)
UPLOAD_DIR=uploads

# External university list API (Hipo Labs). Proxied + cached by this API.
UNIVERSITY_API_URL=http://universities.hipolabs.com/search

# Email (verification + password reset). Leave SMTP_HOST empty in development:
# emails are then printed to the server console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AbroadMates <team@abroadmates.com>"

# Cloudflare Turnstile secret. When empty the captcha check is skipped (development only).
TURNSTILE_SECRET_KEY=

# Google sign-in (OAuth client id used to verify ID tokens). When empty, /auth/google returns 501.
GOOGLE_CLIENT_ID=
